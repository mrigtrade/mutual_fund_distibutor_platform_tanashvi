# ============================================================================
# Tanashvi Fintech B2B Mutual Fund Platform - Environment Configuration
# ============================================================================

# Platform Configuration
PORT=4000
NODE_ENV=development

# ----------------------------------------------------------------------------
# BSE StAR MF v2 Gateway Configuration
# ----------------------------------------------------------------------------
# Gateway Mode: 'MOCK' (Offline Simulation - Default) or 'LIVE' (Real BSE HTTP Gateway)
# Zero Live Dependency: Keep 'MOCK' until Static IP Whitelist is approved by BSE!
BSE_GATEWAY_MODE=MOCK

# BSE v2 Target Endpoints:
# - Production Gateway: https://v2.bsestarmf.in/api
# - UAT/QA Gateway:     https://qa.starmfv2.remiges.tech/api
BSE_GATEWAY_URL=https://v2.bsestarmf.in/api

# Master Member Details (Tanashvi Fintech Private Limited)
BSE_MEMBER_CODE=714114
TANASHVI_ARN=ARN-347849

# BSE Assigned Checksum Fingerprint (Provided by BSE during API Onboarding)
# Injected into HTTP Header: X-API-Org-ID: member/714114:<fingerprint>
BSE_MEMBER_FINGERPRINT=BSE_FINGERPRINT_PLACEHOLDER

# ----------------------------------------------------------------------------
# Cryptographic Keys (RSA 2048-bit / PKCS#8)
# In MOCK mode, ephemeral keypairs are automatically generated if left empty.
# In LIVE mode, these must contain your real production/UAT PEM strings.
# ----------------------------------------------------------------------------
# Tanashvi's RSA Private Key (for signing outgoing JWS and decrypting incoming JWE)
BSE_MEMBER_PRIVATE_KEY=""

# Tanashvi's RSA Public Key (registered with BSE Exchange)
BSE_MEMBER_PUBLIC_KEY=""

# BSE Exchange's Public Key (for encrypting outgoing JWE and verifying BSE JWS)
BSE_PUBLIC_KEY=""

# ----------------------------------------------------------------------------
# PostgreSQL Database (Multi-Tenant RLS & Core Ledger)
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://tanashvi_admin:tanashvi_secure_pass@localhost:5432/tanashvi_mf_platform?schema=tanashvi_core
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000

